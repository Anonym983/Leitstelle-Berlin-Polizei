@tasks.loop(minutes=5)
async def update_panel_loop():
    panel_db = load_panel_db()
    db = load_db()
    kanal = bot.get_channel(KANAL_DIENSTNUMMER_PANEL)
    
    if not kanal: return

    if "panel_message_id" in panel_db:
        try:
            nachricht = await kanal.fetch_message(panel_db["panel_message_id"])
            await nachricht.edit(embed=generate_panel_embed(db))
        except discord.NotFound:
            neue_nachricht = await kanal.send(embed=generate_panel_embed(db))
            panel_db["panel_message_id"] = neue_nachricht.id
            save_panel_db(panel_db)
    else:
        neue_nachricht = await kanal.send(embed=generate_panel_embed(db))
        panel_db["panel_message_id"] = neue_nachricht.id
        save_panel_db(panel_db)

