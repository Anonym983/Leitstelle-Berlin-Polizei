class AusweisModal(discord.ui.Modal):
    def __init__(self, antrags_typ):
        super().__init__(title=f"Antrag: {antrags_typ}")
        self.antrags_typ = antrags_typ
        self.name = discord.ui.TextInput(label="Ingame Name", placeholder="z.B. Max Mustermann", required=True)
        self.geburtstag = discord.ui.TextInput(label="Geburtsdatum", placeholder="z.B. 01.01.2000", required=True)
        self.roblox_name = discord.ui.TextInput(label="Roblox Name", placeholder="z.B. @max_muster", required=True)
        self.add_item(self.name)
        self.add_item(self.geburtstag)
        self.add_item(self.roblox_name)

    async def on_submit(self, interaction: discord.Interaction):
        kanal = bot.get_channel(KANAL_AUSWEIS)
        embed = discord.Embed(title=f"🪪 {self.antrags_typ}", color=0x9B59B6)
        embed.add_field(name="Name", value=self.name.value, inline=False)
        embed.add_field(name="Geburtsdatum", value=self.geburtstag.value, inline=False)
        embed.add_field(name="Roblox Name", value=self.roblox_name.value, inline=False)
        embed.set_footer(text=BRANDING_FOOTER)
        await kanal.send(content=f"Antrag von {interaction.user.mention}", embed=embed)
        await interaction.response.send_message("✅ Dein Antrag wurde eingereicht!", ephemeral=True)

class AusweisDropdown(discord.ui.Select):
    def __init__(self):
        options = [
            discord.SelectOption(label="Personalausweis Beantragen", description="Beantrage einen Ingame Personalausweis", value="Personalausweis", emoji="🪪"),
            discord.SelectOption(label="Führerschein (PKW)", value="Führerschein PKW", emoji="🚗"),
            discord.SelectOption(label="Führerschein (LKW)", value="Führerschein LKW", emoji="🚚"),
            discord.SelectOption(label="Führerschein (Motorrad)", value="Führerschein Motorrad", emoji="🏍️"),
            discord.SelectOption(label="Kleiner Waffenschein", value="Kleiner Waffenschein", emoji="🔫"),
            discord.SelectOption(label="Großer Waffenschein", value="Großer Waffenschein", emoji="🔫")
        ]
        super().__init__(placeholder="Wähle eine Kategorie...", min_values=1, max_values=1, options=options)

    async def callback(self, interaction: discord.Interaction):
        await interaction.response.send_modal(AusweisModal(self.values[0]))

class AusweisView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None) 
        self.add_item(AusweisDropdown())

