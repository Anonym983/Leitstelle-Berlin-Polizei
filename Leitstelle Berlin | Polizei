    kanal = bot.get_channel(KANAL_ENTLASSUNG)
    if not kanal: return await interaction.response.send_message("❌ Kanal nicht konfiguriert.", ephemeral=True)
    for _, rollen_id in TEAMLISTE_RAENGE:
        rolle = interaction.guild.get_role(rollen_id)
        if rolle and rolle in user.roles:
            try: await user.remove_roles(rolle)
            except: pass
    try: await user.remove_roles(interaction.guild.get_role(ROLLE_HAUPT_POLIZEI))
    except: pass

    embed = discord.Embed(title="❌ Dienstentlassung", description=f"Der Beamte {user.mention} wurde mit sofortiger Wirkung vom Dienst freigestellt.", color=0xFF0000)
