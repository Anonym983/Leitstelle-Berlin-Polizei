# --- DATENBANK LOGIK ---
DB_FILE = "dienstnummern.json"
PANEL_DB_FILE = "panel_messages.json"

def load_db():
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r") as f:
            return json.load(f)
    return {}

def save_db(data):
    with open(DB_FILE, "w") as f:
        json.dump(data, f, indent=4)

def load_panel_db():
    if os.path.exists(PANEL_DB_FILE):
        with open(PANEL_DB_FILE, "r") as f:
            return json.load(f)
    return {}

def save_panel_db(data):
    with open(PANEL_DB_FILE, "w") as f:
        json.dump(data, f, indent=4)

def get_next_free_number(db):
    for i in range(1, 501):
        nummer = f"BLP{i:02d}"
        if nummer not in db.values():
            return nummer
    return None

def generate_panel_embed(db):
    freie_nummern = []
    for i in range(1, 501):
        nummer = f"BLP{i:02d}"
        if nummer not in db.values():
            freie_nummern.append(nummer)

    embed = discord.Embed(
        title="🪪 Dienstnummern-Übersicht (Live)",
        description="Hier siehst du alle aktuell **freien** Dienstnummern.",
        color=0x9B59B6
    )

    if freie_nummern:
        text_block = ""
        for nummer in freie_nummern:
            text_block += f"{nummer}, "
            if len(text_block) > 900:
                embed.add_field(name="Freie Nummern", value=text_block, inline=False)
                text_block = ""
        if text_block:
            embed.add_field(name="Freie Nummern", value=text_block, inline=False)
    else:
        embed.description = "❌ Es sind aktuell keine Nummern mehr frei (alle 500 vergeben)!"

    embed.set_footer(text=f"{BRANDING_FOOTER} | Aktualisiert um {datetime.datetime.now().strftime('%H:%M')}")
    return embed

