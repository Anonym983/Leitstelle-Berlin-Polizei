def dauer_text(sekunden):
    s = int(sekunden)
    return f"{s // 3600}h {(s % 3600) // 60}min"


def chunk_text(items, limit=1000):
    bloecke, aktuell = [], ""
    for item in items:
        teil = f"{item}, "
        if len(aktuell) + len(teil) > limit:
            bloecke.append(aktuell.rstrip(", "))
            aktuell = ""
        aktuell += teil
    if aktuell:
        bloecke.append(aktuell.rstrip(", "))
    return bloecke


