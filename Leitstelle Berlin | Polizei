class DienstausweisModal(discord.ui.Modal, title="Dienstausweis Registrierung"):
    roblox_name = discord.ui.TextInput(label="Roblox Benutzername", placeholder="z.B. Max_Mustermann123", required=True, max_length=50)

    async def on_submit(self, interaction: discord.Interaction):
        db = load_db()
        user_id = interaction.user.id
        
        for nummer, uid in db.items():
            if uid == user_id:
                return await interaction.response.send_message(f"❌ Du hast bereits die Dienstnummer **{nummer}**.", ephemeral=True)

        neue_nummer = get_next_free_number(db)
        if not neue_nummer:
            return await interaction.response.send_message("❌ Das Register ist voll! Alle 500 Dienstnummern sind vergeben.", ephemeral=True)

        db[neue_nummer] = user_id
        save_db(db)
        await update_panel_loop()

        await interaction.response.send_message(f"✅ Erfolgreich registriert!\nDeine neue Dienstnummer lautet: **{neue_nummer}**\nRoblox-Name: **{self.roblox_name.value}**", ephemeral=True)

class DienstausweisView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)
        self.add_item(discord.ui.Button(label="Dienstausweis beantragen", style=discord.ButtonStyle.primary, custom_id="btn_dienstausweis", emoji="🪪"))

@bot.event
async def on_interaction(interaction: discord.Interaction):
