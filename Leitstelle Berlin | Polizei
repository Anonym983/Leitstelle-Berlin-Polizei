        cur_checks = db.execute("DELETE FROM aktivitaetschecks WHERE abgeschlossen=1 AND frist < ?",
                                (jetzt - 30 * 86400,))
    def _cnt(x):
        return x.rowcount if hasattr(x, "rowcount") else 0
    print(f"🧹 Cleanup: {_cnt(cur_warns)} Warns, {_cnt(cur_logs)} Logs, "
          f"{_cnt(cur_sperren)} Sperren, {_cnt(cur_checks)} Checks entfernt.")


