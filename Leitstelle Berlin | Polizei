class PanelButton(discord.ui.Button):
    def __init__(self, label, style, emoji, panel_typ):
        super().__init__(label=label, style=style, emoji=emoji, custom_id=f"panel_btn_{panel_typ}")
        self.panel_typ = panel_typ

    async def callback(self, interaction: discord.Interaction):
        if self.panel_typ == "ausweis":
            embed = discord.Embed(title="🪪 Kategorie wählen", description="Bitte wähle aus dem Menü unten aus, welchen Ausweis du beantragen möchtest.", color=0x9B59B6)
            await interaction.response.send_message(embed=embed, view=AusweisView(), ephemeral=True)
        else:
            await interaction.response.send_message("Dieser Button hat noch keine Funktion.", ephemeral=True)

class PanelView(discord.ui.View):
    def __init__(self, label, style, emoji, panel_typ):
        super().__init__(timeout=None)
        self.add_item(PanelButton(label, style, emoji, panel_typ))

@bot.tree.command(name="panel_builder", description="Erstellt ein individuelles Panel (Nur für Admins)")
@app_commands.checks.has_permissions(administrator=True)
@app_commands.describe(
    titel="Der Titel des Panels (z.B. Ausweis-Antrag)",
    beschreibung="Der Text unter dem Titel",
    farbe="Hex-Farbe (z.B. #9B59B6 für Lila, #0000FF für Blau)",
    button_text="Was auf dem Button stehen soll",
    button_typ="Was der Button machen soll",
    emoji="Ein Emoji für den Button (optional)"
)
@app_commands.choices(button_typ=[
    app_commands.Choice(name="Ausweis-Antrag öffnen", value="ausweis"),
    app_commands.Choice(name="Einfacher Info-Button", value="info")
])
async def panel_builder(
    interaction: discord.Interaction, 
    titel: str, 
    beschreibung: str, 
    farbe: str, 
    button_text: str, 
    button_typ: app_commands.Choice[str],
    emoji: str = "📝"
):
    try:
        farbe_int = int(farbe.strip('#'), 16)
    except ValueError:
        return await interaction.response.send_message("❌ Ungültige Farbe! Nutze z.B. #FF0000", ephemeral=True)

    embed = discord.Embed(title=titel, description=beschreibung, color=farbe_int)
    embed.set_footer(text=BRANDING_FOOTER)
    view = PanelView(label=button_text, style=discord.ButtonStyle.primary, emoji=emoji, panel_typ=button_typ.value)
    await interaction.response.send_message("✅ Panel erstellt!", ephemeral=True)
    await interaction.channel.send(embed=embed, view=view)


