@bot.tree.command(name="dienstnummer", description="Teilt einem Beamten eine Dienstnummer zu (Nur für die Führungsebene)")
async def dienstnummer(interaction: discord.Interaction, user: discord.Member, wunsch_nummer: str = None):
    if not any(role.id in ROLLEN_DIENSTNUMMER_MANAGER for role in interaction.user.roles):
        return await interaction.response.send_message("❌ Keine Berechtigung.", ephemeral=True)
    db = load_db()
    kanal = bot.get_channel(KANAL_DIENSTNUMMER)
    
    alte_nummer_des_users = next((n for n, i in db.items() if i == user.id), None)
    besitzer_der_nummer = None
    zugewiesene_nummer = None

    if wunsch_nummer:
        wunsch_nummer = wunsch_nummer.upper().strip()
        if not wunsch_nummer.startswith("BLP"):
            wunsch_nummer = f"BLP{wunsch_nummer.zfill(2)}"
        
        if wunsch_nummer in db and db[wunsch_nummer] != user.id:
            besitzer_der_nummer = db[wunsch_nummer]
            neue_nummer_fuer_alten = get_next_free_number(db)
            if neue_nummer_fuer_alten:
                db[neue_nummer_fuer_alten] = besitzer_der_nummer
                if kanal:
                    try:
                        alter_user = await bot.fetch_user(besitzer_der_nummer)
                        await kanal.send(f"⚠️ **Update:** {alter_user.mention}, deine Nummer **{wunsch_nummer}** wurde übertragen. Du hast nun **{neue_nummer_fuer_alten}**.")
                    except: pass
        zugewiesene_nummer = wunsch_nummer
    else:
        zugewiesene_nummer = get_next_free_number(db)
        if not zugewiesene_nummer:
            return await interaction.response.send_message("❌ Alle Nummern vergeben!", ephemeral=True)

    if alte_nummer_des_users:
        del db[alte_nummer_des_users]

    db[zugewiesene_nummer] = user.id
    save_db(db)
    await update_panel_loop()

    embed = discord.Embed(title="🪪 Dienstnummer zugewiesen", description=f"Dem Beamten {user.mention} wurde die Dienstnummer **{zugewiesene_nummer}** zugeteilt.", color=0x00FF00)
    embed.set_footer(text=BRANDING_FOOTER)
    if besitzer_der_nummer:
        embed.add_field(name="🔄 Übertragung", value=f"Der vorherige Besitzer hat eine neue Nummer erhalten.", inline=False)

    await interaction.response.send_message(embed=embed)
    if kanal: await kanal.send(content=user.mention, embed=embed)

@bot.tree.command(name="dienstnummer_info", description="Zeigt die Dienstnummer eines Beamten an")
async def dienstnummer_info(interaction: discord.Interaction, user: discord.Member):
    db = load_db()
    gefundene_nummer = next((n for n, i in db.items() if i == user.id), None)

    if gefundene_nummer:
        await interaction.response.send_message(f"👮‍♂️ {user.mention} hat die Dienstnummer **{gefundene_nummer}**.", ephemeral=True)
    else:
        await interaction.response.send_message(f"❌ {user.mention} hat noch keine Dienstnummer zugewiesen bekommen.", ephemeral=True)

