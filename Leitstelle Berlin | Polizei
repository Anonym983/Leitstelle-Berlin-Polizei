# SYSTEM 1: Anwalt Trigger
# ==========================================
anwalt_cooldowns = {}

@bot.event
async def on_message(message):
    if message.author.bot: return
    if message.channel.id == KANAL_ANWALT:
        if "anwalt" in message.content.lower():
            user_id = message.author.id
            jetzt = time.time()
            if user_id in anwalt_cooldowns and anwalt_cooldowns[user_id] - jetzt > 0:
                minuten = int((anwalt_cooldowns[user_id] - jetzt) // 60)
                await message.reply(f"⏳ Bitte warte noch **{minuten} Minuten**.", delete_after=10)
                return
            
            anwalt_cooldowns[user_id] = jetzt + (15 * 60)
            embed = discord.Embed(title="⚖️ Anwalt angefordert", description=f"Ein Anwalt wird für {message.author.mention} benötigt.\n\n<@&{ROLLE_ANWALT}>, bitte meldet euch!", color=0x0000FF)
            embed.set_footer(text=BRANDING_FOOTER)
            await message.reply(content=f"<@&{ROLLE_ANWALT}>", embed=embed)
            try: await message.delete()
            except: pass
    await bot.process_commands(message)

