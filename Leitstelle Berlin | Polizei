@bot.event
async def on_member_update(before: discord.Member, after: discord.Member):
    if before.roles != after.roles:
        rollen_vorher = [r.id for r in before.roles]
        rollen_nachher = [r.id for r in after.roles]

        hatte_hauptrolle = ROLLE_HAUPT_POLIZEI in rollen_vorher
        hat_hauptrolle = ROLLE_HAUPT_POLIZEI in rollen_nachher

        if not hatte_hauptrolle and hat_hauptrolle:
            kanal = bot.get_channel(KANAL_EINSTELLUNG)
            if kanal:
                await kanal.send(f"👋 {after.mention} ist nun offiziell Teil der Fraktion!")

        elif hatte_hauptrolle and not hat_hauptrolle:
            db = load_db()
            user_id = after.id
            nummer_entfernt = None

            for nummer, uid in list(db.items()):
                if uid == user_id:
                    del db[nummer]
                    nummer_entfernt = nummer
                    break

            if nummer_entfernt:
                save_db(db)
                await update_panel_loop()
                kanal = bot.get_channel(KANAL_DIENSTNUMMER)
                if kanal:
                    embed = discord.Embed(
                        title="🚫 Dienstnummer entzogen",
                        description=f"{after.mention} hat die Fraktion verlassen. Die Dienstnummer **{nummer_entfernt}** wurde wieder freigegeben.",
                        color=0xFF0000
                    )
                    embed.set_footer(text=BRANDING_FOOTER)
                    await kanal.send(embed=embed)

