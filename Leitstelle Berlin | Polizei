@bot.tree.command(name="teamliste", description="Erstellt eine aktuelle Teamliste")
async def teamliste(interaction: discord.Interaction):
    await interaction.response.defer() 
    guild = interaction.guild
    embed = discord.Embed(title=f"👮‍♂️ Teamliste | {BRANDING_NAME}", color=0x0000FF)
    if guild.icon: embed.set_thumbnail(url=guild.icon.url)
    
    beschreibung = ""
    for name, rollen_id in TEAMLISTE_RAENGE:
        rolle = guild.get_role(rollen_id)
        if rolle:
            mitglieder = [m.mention for m in rolle.members]
            beschreibung += f"**{name}**\n{', '.join(mitglieder) if mitglieder else '*Aktuell niemand*'}\n\n"
        else:
            beschreibung += f"**{name}**\n*Rolle nicht gefunden (ID falsch)*\n\n"
            
    embed.description = beschreibung
    embed.set_footer(text=BRANDING_FOOTER)
    await interaction.followup.send(embed=embed)

