    log_cutoff = jetzt - CLEANUP_LOG_NACH_TAGEN * 86400
    with db:
        cur_warns = db.execute("DELETE FROM warns WHERE ablauf < ? AND ablauf < ?", (jetzt, warn_cutoff))
        cur_logs = db.execute("DELETE FROM dienst_log WHERE ende < ?", (log_cutoff,))
